# SecureFlow AI — Backend Environment Variables

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# API Security
API_KEY=your-secret-api-key-here

# CORS — Chrome Extension origin
ALLOWED_ORIGINS=chrome-extension://your-extension-id

# Database
DATABASE_URL=sqlite+aiosqlite:///./secureflow.db

# spaCy Model (en_core_web_trf for GPU, en_core_web_sm for CPU)
SPACY_MODEL=en_core_web_sm

# BERT Risk Classifier
BERT_MODEL_PATH=./models/bert_risk_classifier
BERT_CONFIDENCE_THRESHOLD=0.6

# Token Map
TOKEN_MAP_TTL_MINUTES=30

# Rate Limiting
RATE_LIMIT=60/minute
